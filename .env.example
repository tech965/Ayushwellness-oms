# ============================================================
# AyushWellness OMS — environment variable reference
# ============================================================
# Copy this to .env (root, used by docker-compose) and to
# apps/api/.env (backend) as needed. NEVER commit a real .env file.
# See docs/development/environment.md for a description of every
# variable and which phase actually uses it.

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://oms_user:oms_password@localhost:5432/ayushwellness_oms
POSTGRES_USER=oms_user
POSTGRES_PASSWORD=oms_password
POSTGRES_DB=ayushwellness_oms

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT / Auth ---
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ACCESS_TOKEN_EXPIRE=900
JWT_REFRESH_TOKEN_EXPIRE=1209600

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- OMS AI Assistant / chatbot (optional — POST /api/v1/chat returns a
# friendly "not configured" message until GROQ_API_KEY is set; the API
# starts fine without it). Groq serves an OpenAI-compatible Chat
# Completions API with tool calling. Server-side only — never exposed to
# the browser. ---
CHAT_ENABLED=true
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
# A Groq-hosted model that supports tool/function calling. Verify it's in
# your account's catalogue: GET https://api.groq.com/openai/v1/models
CHAT_LLM_MODEL=openai/gpt-oss-120b
CHAT_MAX_TOOL_ITERATIONS=6
CHAT_LLM_TIMEOUT_SECONDS=45
CHAT_HISTORY_MAX_MESSAGES=20

# --- Shopify (Phase 2.2 — implemented; leave blank until credentials
# are issued, the integration reports "Not Configured" until then) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Client Credentials Grant (Shopify's current Dev Dashboard app model) —
# preferred over SHOPIFY_ACCESS_TOKEN whenever both are set. Requires the
# app to be installed on SHOPIFY_STORE_DOMAIN with client-credentials
# grant permitted; otherwise leave both blank and use SHOPIFY_ACCESS_TOKEN
# (a custom-app access token from Shopify Admin > Settings > Apps and
# sales channels > Develop apps) instead.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Only during a Shopify Client Secret rotation — the previous secret,
# kept until it's revoked on Shopify's side. Leave blank otherwise.
SHOPIFY_WEBHOOK_SECRET_OLD=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-01
# This deployment's own public webhook URL — used only by
# scripts/register_shopify_webhooks.py, never by the running API.
SHOPIFY_WEBHOOK_CALLBACK_URL=

# --- Shiprocket (Phase 2.3 — implemented; leave blank until credentials
# are issued, the integration reports "Not Configured" until then) ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_WEBHOOK_SECRET=
# Pickup location nickname exactly as configured in the Shiprocket
# dashboard — required only to create shipments ("Ship via Shiprocket").
SHIPROCKET_PICKUP_LOCATION=

# --- Blue Dart (Phase 2 foundation — leave blank until credentials are issued) ---
BLUE_DART_API_URL=
BLUE_DART_API_KEY=
BLUE_DART_CLIENT_ID=
BLUE_DART_CLIENT_SECRET=

# --- Cashfree Payments (implemented; leave blank until credentials are
# issued — checkout creation reports "Not Configured" until then, matching
# Shopify/Shiprocket's convention). See docs/integrations/cashfree.md. ---
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
# Optional — only needed if this Cashfree account has a webhook signing
# key distinct from its client secret; leave unset to use
# CASHFREE_CLIENT_SECRET (Cashfree's documented default/common case).
CASHFREE_WEBHOOK_SECRET=
# Optional order_meta.return_url template (a "{order_id}" placeholder is
# substituted) — checkout works without it.
CASHFREE_RETURN_URL=

# --- WhatsApp (Phase 5 — leave blank) ---
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# --- Meta (Phase 6 — leave blank) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
